# Copy to .env and fill in. Every value is optional: with no .env the stack runs
# end to end against the in-stack stub LLM (no API key, no cost).
# Nothing in this file is committed with real values; .env is git-ignored.

# ---------------------------------------------------------------- LLM provider
# Any OpenAI-compatible chat-completions endpoint (a hosted free tier, Ollama,
# OpenRouter, ...). BASE_URL is the API root that ends before /chat/completions.
# MODEL is the provider's model id (see your provider's docs; choose one that
# supports tool/function calling). Leave all three empty to use the stub.
LLM_PRIMARY_BASE_URL=
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=
# USD per 1M tokens, used to record cost at call time (0 for free tiers).
LLM_PRIMARY_PRICE_IN_PER_MTOK=0
LLM_PRIMARY_PRICE_OUT_PER_MTOK=0
LLM_PRIMARY_TIMEOUT_S=30
# true only if the provider supports response_format={"type":"json_object"}
LLM_PRIMARY_JSON_MODE=false

# Optional second provider, used when the primary's circuit is open.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_PRICE_IN_PER_MTOK=0
LLM_FALLBACK_PRICE_OUT_PER_MTOK=0

# Resilience (A5)
LLM_MAX_RETRIES=2
LLM_BACKOFF_BASE_S=0.5
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_S=30
# /admin/fault on the gateway (demo of provider outage). Set false in production.
ENABLE_FAULT_INJECTION=true

# Stub provider latency (used for load tests, D6)
STUB_DELAY_MS_MIN=800
STUB_DELAY_MS_MAX=2000

# ------------------------------------------------------------------ embeddings
# Local sentence-transformers model, baked into the retriever image at build time.
# Defaults to the small MiniLM model named in the brief; changing it triggers a
# full re-embed on the next indexer run.
# EMBEDDING_MODEL=

# --------------------------------------------------------------------- agents
WORKER_CONCURRENCY=4
RESEARCHER_MAX_STEPS=14
RESEARCHER_MAX_TOOL_CALLS=24
RESEARCHER_DEADLINE_S=120
ASSESSOR_DEADLINE_S=90
TOOL_TIMEOUT_S=10
LLM_CLIENT_TIMEOUT_S=75
# assessor prompt variant: v1 | v2  (L2)
PROMPT_VARIANT_ASSESSOR=v2
# the deliberate change for L3: disable the modifier-search step
MODIFIER_SEARCH_ENABLED=true
# elide old tool results from the research agent's context (cost control)
CONTEXT_COMPACTION_ENABLED=true
ONLINE_EVAL_SAMPLE_RATE=0.25

# ------------------------------------------------------------------------ API
RATE_LIMIT_PER_MINUTE=20
# per-client overrides: name:limit,name:limit
RATE_LIMIT_OVERRIDES=eval:600,loadtest:100000
RUN_CACHE_ENABLED=true
RETRIEVAL_CACHE_ENABLED=true
LLM_CACHE_ENABLED=true
RUN_DEADLINE_S=300
LOG_LEVEL=INFO
# Where links to traces should point (the Jaeger UI as seen from your browser)
JAEGER_UI_URL=http://localhost:16686
