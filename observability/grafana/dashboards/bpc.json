      "id": 12,
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "description": "assessor success = routed with verified findings; escalations are counted separately",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 27
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom"
          },
          "expr": "sum(rate(agent_tasks_total{outcome=\"success\"}[15m])) by (agent) / clamp_min(sum(rate(agent_tasks_total[15m])) by (agent), 1e-9)",
